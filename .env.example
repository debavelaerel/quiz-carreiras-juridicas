# Copie para .env.local e preencha. Valores de DESENVOLVIMENTO LOCAL (sem segredos).
# Produção (AWS): ver docs/DEPLOY.md — lá ACCESS_KEY/SECRET_KEY/S3_* ficam vazias (IAM role).
# SUPABASE_SERVICE_ROLE_KEY: `npx supabase status` → service_role / "Secret key".

SUPABASE_URL=http://127.0.0.1:65521
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=troque-isto
ADMIN_SESSION_SECRET=troque-por-openssl-rand-base64-48
LAUDO_SERVICE_URL=http://localhost:8100
LAUDO_SERVICE_SECRET=segredo-local
BUCKET_NAME=diagnosticos-cj
REGION=sa-east-1
ACCESS_KEY=minioadmin
SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9100
S3_PUBLIC_ENDPOINT=http://localhost:9100
